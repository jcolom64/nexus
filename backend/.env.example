# Local development defaults — copy to .env and adjust as needed.

# Postgres connection (matches docker-compose.yml)
DATABASE_URL=postgresql://nexus:nexus@localhost:5432/nexus?schema=public

# API
PORT=3001

# JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=8h

# CORS — comma-separated list of allowed Angular dev origins
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4204

# Encryption key for stored data-source credentials (AES-256-GCM).
# 32 bytes / 64 hex chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this key invalidates every existing source password — they'd
# need to be re-saved through the UI/API. Don't lose it.
CREDENTIALS_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
