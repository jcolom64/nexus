// Phase 1 schema: Auth + Users only.
// Future phases (User Groups, Audit, Assets, etc.) will extend this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMINISTRATOR
  MANAGER
  USER
  AUDITOR
}

enum UserState {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
}

// Permissions assignable to a UserGroup. Distinct from UserRole — these are
// fine-grained authorizations a group confers on its members within an
// account, not the user's overall role.
enum SystemRole {
  SYSTEM_ADMIN
  ACCOUNT_VIEWER
  LICENSE_OVERRIDE
  USER_VIEWER
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(USER)
  state        UserState  @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  groups       UserGroup[] @relation("UserGroupMembers")

  @@map("users")
}

// Tenants / business accounts the platform manages. Read-only from the API
// for now — provisioning lives outside this app.
model Account {
  id   String @id
  name String

  groupAssignments GroupAccountAssignment[]

  @@map("accounts")
}

model UserGroup {
  id           String       @id @default(cuid())
  name         String       @unique
  description  String       @default("")
  systemRoles  SystemRole[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  accountAssignments GroupAccountAssignment[]
  members            User[]                   @relation("UserGroupMembers")

  @@map("user_groups")
}

// Per-account permission attached to a group. (Group, Account) is unique.
model GroupAccountAssignment {
  group     UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  account   Account   @relation(fields: [accountId], references: [id])
  accountId String
  role      SystemRole

  @@id([groupId, accountId])
  @@map("group_account_assignments")
}

// Append-only audit trail of meaningful server actions.
enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  ACCESS
  EXPORT
}

enum AuditCategory {
  AUTH
  USER
  CONFIG
  DATA
  SECURITY
}

enum AuditOutcome {
  SUCCESS
  FAILED
  WARNING
}

model AuditEntry {
  id           String        @id @default(cuid())
  timestamp    DateTime      @default(now())
  actorId      String?       // null for anonymous (failed login pre-auth)
  actorEmail   String
  actorName    String?
  action       AuditAction
  category     AuditCategory
  resource     String        // e.g., user email, group name, path
  resourceType String        // e.g., 'User', 'Group', 'Session'
  source       String?       // IP / origin
  outcome      AuditOutcome
  metadata     Json?

  @@map("audit_entries")
  @@index([timestamp])
  @@index([category])
  @@index([actorEmail])
  @@index([action])
}

// Singleton tables. There is exactly one row in each, keyed by a fixed id.
// Reads upsert defaults on first hit so a fresh DB never has to be seeded.

model SystemConfig {
  id                       String   @id @default("singleton")

  // General
  appNameOverride          String   @default("Nexus")
  defaultTheme             String   @default("default")
  defaultLocale            String   @default("en-US")
  defaultTimezone          String   @default("UTC")
  dateFormat               String   @default("YYYY-MM-DD")
  firstDayOfWeek           String   @default("sunday")

  // Data sources (defaults; connections are listed separately)
  defaultRefreshSeconds    Int      @default(300)
  defaultRetryAttempts     Int      @default(3)
  retryBackoffMultiplier   Int      @default(2)
  maxConcurrentConnectors  Int      @default(8)

  // Notifications & Email
  smtpHost                 String   @default("smtp.nexus.com")
  smtpPort                 Int      @default(587)
  smtpRequireAuth          Boolean  @default(true)
  smtpUsername             String   @default("no-reply@nexus.com")
  smtpFromAddress          String   @default("no-reply@nexus.com")
  notificationEvents       Json     // [{ id, label, enabled }]
  slackWebhookUrl          String   @default("")
  teamsWebhookUrl          String   @default("")

  // Performance & Limits
  cacheTtlSeconds          Int      @default(600)
  queryTimeoutSeconds      Int      @default(30)
  maxUploadMb              Int      @default(100)
  maxConcurrentJobs        Int      @default(16)
  workerPoolSize           Int      @default(8)

  updatedAt                DateTime @updatedAt

  @@map("system_config")
}

// ---- Sources & Assets (Phase 5a) ------------------------------------------
//
// A `Source` is a registered external data system (Postgres database,
// Kafka cluster, S3 bucket, REST partner, etc.). An `Asset` is something
// discovered inside a source (table / view / topic / file / endpoint).
// Lineage is captured as directed edges in `AssetLineage`.
//
// Phase 5a intentionally has no connector code: status / lastSyncAt are
// edited by humans, and assets are seeded explicitly. Phase 5b layers a
// real Postgres connector on top of this metadata model.

enum SourceType {
  POSTGRES
  MYSQL
  MONGODB
  S3
  REST_API
  KAFKA
  SNOWFLAKE
  REDIS
}

enum SourceStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
  STALE
}

model Source {
  id          String       @id @default(cuid())
  name        String       @unique
  type        SourceType
  status      SourceStatus @default(DISCONNECTED)
  description String       @default("")

  // Connection details. `passwordEncrypted` holds an AES-256-GCM bundle
  // (iv.ciphertext.tag, base64) keyed off the CREDENTIALS_KEY env var —
  // see `connectors/credentials.ts`. Password is write-only on the API.
  host              String?
  port              Int?
  database          String?
  username          String?
  passwordEncrypted String?

  lastSyncAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  assets      Asset[]

  @@map("sources")
}

enum AssetType {
  TABLE
  VIEW
  TOPIC
  FILE
  API
}

enum AssetTag {
  PII
  GDPR
  SENSITIVE
  CERTIFIED
  DEPRECATED
  GOLDEN
}

enum AssetDomain {
  SALES
  FINANCE
  MARKETING
  PRODUCT
  COMPLIANCE
  OPS
}

model Asset {
  id            String      @id @default(cuid())
  name          String
  qualifiedName String      @unique
  type          AssetType

  source        Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceId      String

  // Schema is a JSON array of `{ name, type, pii? }` entries — too sparse
  // to be worth a normalised column table at this stage.
  schema        Json
  rowCount      Int         @default(0)
  sizeMb        Int         @default(0)

  // Ownership is denormalised — owner may be a non-user (team alias, etc.).
  // Email is the canonical identifier; name is a display convenience.
  ownerEmail    String?
  ownerName     String?

  domain        AssetDomain
  tags          AssetTag[]  @default([])

  description   String      @default("")
  lastUpdatedAt DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  upstreamEdges   AssetLineage[] @relation("downstream")
  downstreamEdges AssetLineage[] @relation("upstream")

  @@map("assets")
  @@index([sourceId])
  @@index([domain])
}

// Directed edge: upstreamId → downstreamId. Two FKs to Asset; both cascade
// on delete so removing an asset cleans up its lineage entries.
model AssetLineage {
  upstream     Asset  @relation("upstream",   fields: [upstreamId],   references: [id], onDelete: Cascade)
  upstreamId   String
  downstream   Asset  @relation("downstream", fields: [downstreamId], references: [id], onDelete: Cascade)
  downstreamId String

  @@id([upstreamId, downstreamId])
  @@map("asset_lineage")
}

// Install-time license, stored as a singleton row. Written by an
// out-of-band CLI (`npm --prefix backend run license:apply`); there is
// intentionally no admin-facing PUT/PATCH on this resource. Empty
// `licenseExpires` means "never expires". `seatsUsed` is derived from
// the live user count and doesn't live here.
model License {
  id              String   @id @default("singleton")
  licenseKey      String   @default("NEXUS-DEV-LCNS-LOCAL-DEV-INST-2026")
  plan            String   @default("enterprise")
  seatsTotal      Int      @default(50)
  licenseExpires  String   @default("")
  appliedAt       DateTime @default(now())
  appliedBy       String?
  notes           String?

  @@map("licenses")
}

model SecuritySettings {
  id                       String   @id @default("singleton")

  // Authentication
  loginMethods             String[] @default([])
  mfaMode                  String   @default("optional")
  ssoIssuer                String   @default("")
  sessionTimeoutMinutes    Int      @default(30)
  rememberMeEnabled        Boolean  @default(true)

  // Password policy
  passwordMinLength        Int      @default(12)
  passwordRequireUppercase Boolean  @default(true)
  passwordRequireLowercase Boolean  @default(true)
  passwordRequireNumber    Boolean  @default(true)
  passwordRequireSymbol    Boolean  @default(false)
  passwordExpiryDays       Int      @default(90)
  passwordHistoryCount     Int      @default(5)

  // Account lockout
  failedAttemptThreshold   Int      @default(5)
  lockoutDurationMinutes   Int      @default(15)

  // Network
  ipAllowlist              String   @default("")
  rateLimitPerMinute       Int      @default(600)

  // Compliance
  tlsMinimumVersion        String   @default("1.2")
  encryptionAtRest         Boolean  @default(true)
  auditRetentionDays       Int      @default(365)

  updatedAt                DateTime @updatedAt

  @@map("security_settings")
}
